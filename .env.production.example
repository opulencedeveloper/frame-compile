# Production environment for FrameCompile.
#
# A template: copy each value into your host's environment settings
# (Railway, Render, Fly.io, ...). Never commit real values; .env* files other
# than this example are ignored by git.
#
# The server must run as a normal Node server or Docker container, not
# serverless functions: conversions run headless Chromium and git, and take
# about a minute. The Playwright Docker image (mcr.microsoft.com/playwright)
# includes both.

# ----- App -----

# The app's public address. Preview links use its scheme (https).
APP_URL=https://framecompile.com

# ----- Database -----

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# ----- Sessions -----

# At least 32 random characters, different from development.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# ----- Google sign-in -----

# Add https://framecompile.com/api/v1/auth/google/callback as an authorized
# redirect URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Email (Resend) -----

RESEND_API_KEY=
# A sender on a domain verified in Resend.
MAIL_FROM=FrameCompile <noreply@framecompile.com>

# ----- Converted project storage (GitHub) -----

# A token for the storage account. Classic: the "repo" scope. Fine-grained:
# all repositories, Administration and Contents read and write.
GITHUB_TOKEN=
# The storage account's username, or an organization name.
GITHUB_OWNER=

# ----- Stored secrets -----

# Encrypts users' Vercel tokens. 32 random bytes, base64:
#   openssl rand -base64 32
# Changing it later means users reconnect Vercel.
TOKEN_ENCRYPTION_KEY=

# ----- Previews -----

# A separate domain used only for previews, never the app's own domain.
# Needs a wildcard DNS record (*.framecompile-preview.app -> this server) and
# a wildcard HTTPS certificate. Previews open at
# https://<id>.framecompile-preview.app
PREVIEW_HOST=framecompile-preview.app

# ----- Browser pass -----

# Leave unset when Chromium is installed with Playwright (the Playwright
# Docker image, or `npx playwright-core install --with-deps chromium`).
# Set it only for a Chromium installed another way, e.g. /usr/bin/chromium.
# BROWSER_EXECUTABLE_PATH=
